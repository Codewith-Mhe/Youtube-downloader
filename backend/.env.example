# --- Server ---
LOG_LEVEL=INFO
PORT=8000

# --- CORS ---
# Comma-separated origins allowed to call this API.
# In production, set this to your frontend URL (e.g. https://clipfetch.example.com).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limits (SlowAPI format) ---
RATE_LIMIT_FETCH=10/minute
RATE_LIMIT_DOWNLOAD=30/minute

# --- Reverse proxy ---
# Set to "true" ONLY when running behind a trusted reverse proxy (Nginx, Cloudflare,
# Render, Railway). When true, X-Forwarded-For is used for rate-limit IP.
TRUST_PROXY=false

# --- Extraction ---
EXTRACT_TIMEOUT_SECONDS=25
